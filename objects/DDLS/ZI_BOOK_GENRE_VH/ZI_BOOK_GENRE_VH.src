@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Book Genre - Value Help'
@ObjectModel.resultSet.sizeCategory: #XS
define view entity ZI_BOOK_GENRE_VH
  as select distinct from zbook_a
{
  key genre as Genre
}
where
  genre <> ''
